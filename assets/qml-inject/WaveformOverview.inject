path: /Skins/Embedded/Views/Common/WaveformOverview/WaveformOverview.qml
after: objectName: "Deck_WaveformOverview_WaveformOverviewView"
---
// ---- Emulator: software stand-in for Engine's OpenGL overview (assets/qml-inject) ---------
Item {
    id: emuOverview
    anchors.fill: parent
    z: -1
    readonly property QObjProperty pNet: Planck.getProperty(`/Engine/Deck${waveformOverview.deckIndex}/Track/TrackNetworkPath`)
    readonly property string net: pNet && pNet.translator ? pNet.translator.string : ""
    property string src: ""
    onNetChanged: { src = ""; emuOverviewFetch.tries = 0; emuOverviewFetch.asked = false; if (net !== "") emuOverviewFetch.restart() }
    Component.onCompleted: if (net !== "") emuOverviewFetch.restart()
    Timer {
        id: emuOverviewFetch
        property int tries: 0
        interval: 600; repeat: true; triggeredOnStart: true
        property bool asked: false
        onTriggered: {
            // Ask the emulator's viewer for this track's picture through files (see viewer/waves.py).
            const want = emuOverview.net
            if (++tries > 300 || want === "") { stop(); return }
            const c = Math.emuWaves || (Math.emuWaves = {})
            const use = r => { if (emuOverview.net === want) { emuOverview.src = r.overview } stop() }
            if (c[want]) { use(c[want]); return }
            const key = Qt.md5(want)
            if (!asked) {
                asked = true
                const w = new XMLHttpRequest()
                w.open("PUT", "file:///tmp/emu/wave/req/" + key)
                w.send(want)
            }
            const x = new XMLHttpRequest()
            x.onreadystatechange = function() {
                if (x.readyState !== XMLHttpRequest.DONE || !x.responseText) return
                let r
                try { r = JSON.parse(x.responseText) } catch (e) { return }
                if (r.state === "ready") { c[want] = r; use(r) }
                else if (r.state !== "pending") { console.warn("emulator waveform: " + r.state); stop() }
            }
            x.open("GET", "file:///tmp/emu/wave/" + key + ".json")
            x.send()
        }
    }
    Image { anchors.fill: parent; source: emuOverview.src; asynchronous: true; smooth: true }
    Rectangle { // played part, dimmed
        visible: emuOverview.src !== ""
        width: parent.width * waveformOverview.playPosition; height: parent.height
        color: "#a0000000"
    }
    Rectangle { // needle
        visible: emuOverview.src !== ""
        x: parent.width * waveformOverview.playPosition - 1; width: 2; height: parent.height
        color: "white"
    }
}
// ------------------------------------------------------------------------------------------
