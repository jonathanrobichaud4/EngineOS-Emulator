path: /Skins/Embedded/Views/Common/Waveform/Waveform.qml
after: id: waveformView
---
// ---- Emulator: software stand-in for Engine's OpenGL waveform (files/qml-inject) ----------
// Engine's waveform item is switched off under the software renderer. This child shows the
// emulator's own picture of the track (made by viewer.py) and scrolls it with the play position.
Item {
    id: emuWave
    z: -1
    anchors.fill: parent
    clip: true
    readonly property QObjProperty pNet: Planck.getProperty(`/Engine/Deck${waveformView.deckIndex}/Track/TrackNetworkPath`)
    readonly property string net: pNet && pNet.translator ? pNet.translator.string : ""
    readonly property QObjProperty pPos: Planck.getProperty(`/Engine/Deck${waveformView.deckIndex}/Track/PlayPosition`)
    property real pos: 0
    property string src: ""
    property real seconds: 0
    onNetChanged: { src = ""; seconds = 0; emuWaveFetch.tries = 0; emuWaveFetch.asked = false; if (net !== "") emuWaveFetch.restart() }
    Component.onCompleted: if (net !== "") emuWaveFetch.restart()
    Timer {
        id: emuWaveFetch
        property int tries: 0
        interval: 600; repeat: true; triggeredOnStart: true
        property bool asked: false
        onTriggered: {
            // Ask the emulator's viewer for this track's picture through files (see viewer.py, Waves).
            const want = emuWave.net
            if (++tries > 300 || want === "") { stop(); return }
            const c = Math.emuWaves || (Math.emuWaves = {})
            const use = r => { if (emuWave.net === want) { emuWave.seconds = r.seconds; emuWave.src = r.main } stop() }
            if (c[want]) { use(c[want]); return }
            const key = Qt.md5(want)
            if (!asked) {
                asked = true
                const w = new XMLHttpRequest()
                w.open("PUT", "file:///tmp/emu/wave/req/" + key)
                w.send(want)
            }
            const x = new XMLHttpRequest()
            x.onreadystatechange = function() {
                if (x.readyState !== XMLHttpRequest.DONE || !x.responseText) return
                let r
                try { r = JSON.parse(x.responseText) } catch (e) { return }
                if (r.state === "ready") { c[want] = r; use(r) }
                else if (r.state !== "pending") { console.warn("emulator waveform: " + r.state); stop() }
            }
            x.open("GET", "file:///tmp/emu/wave/" + key + ".json")
            x.send()
        }
    }
    Timer {
        interval: 40; repeat: true; running: emuWave.src !== "" && waveformView.visible
        onTriggered: emuWave.pos = emuWave.pPos && emuWave.pPos.translator ? emuWave.pPos.translator.value : 0
    }
    Image {
        source: emuWave.src
        asynchronous: true
        smooth: false
        anchors.verticalCenter: parent.verticalCenter
        height: parent.height
        width: emuWave.seconds * parent.width / Math.max(1, waveformView.amountOfSecondsVisible)
        x: parent.width * waveformView.nowLinePosition - emuWave.pos * width
    }
}
// ------------------------------------------------------------------------------------------
